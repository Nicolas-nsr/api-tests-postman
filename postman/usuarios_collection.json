{
  "info": {
    "_postman_id": "df0f2fa1-fb3f-4387-a1cb-3564c251f8b9",
    "name": "ServeRest - Usuarios",
    "description": "Collection completa para testes da API ServeRest focada no módulo de Usuários.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Caminho Feliz",
      "item": [
        {
          "name": "1. Login Válido",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "let json;",
                  "try { json = pm.response.json(); } catch (e) { json = {}; }",
                  "",
                  "pm.test(\"Response has authorization token\", () => {",
                  "  pm.expect(json).to.have.property(\"authorization\");",
                  "  pm.expect(json.authorization).to.be.a(\"string\").and.to.not.be.empty;",
                  "});",
                  "",
                  "// Store token",
                  "if (json && json.authorization) {",
                  "  pm.environment.set(\"authToken\", json.authorization);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": ["{{baseUrl}}"],
              "path": ["login"]
            }
          }
        },
        {
          "name": "2. Criar usuário válido",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const email = `teste_${Date.now()}@qa.com`;",
                  "pm.environment.set(\"testUserEmail\", email);",
                  "pm.environment.set(\"testUserEmail2\", `dup_${Date.now()}@qa.com`);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 201 (created)\", () => {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "let json = {};",
                  "try { json = pm.response.json(); } catch(e) {}",
                  "",
                  "pm.test(\"Has success message\", () => {",
                  "  pm.expect(json).to.have.property(\"message\");",
                  "  pm.expect(json.message).to.be.a(\"string\").that.includes(\"Cadastro\");",
                  "});",
                  "",
                  "// Save ID",
                  "if (json && json._id) {",
                  "  pm.environment.set(\"testUserId\", json._id);",
                  "} else if (json && json.id) {",
                  "  pm.environment.set(\"testUserId\", json.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "{{authToken}}", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Usuário Teste\",\n  \"email\": \"{{testUserEmail}}\",\n  \"password\": \"teste123\",\n  \"administrador\": \"true\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/usuarios",
              "host": ["{{baseUrl}}"],
              "path": ["usuarios"]
            }
          }
        },
        {
          "name": "3. Listar todos os usuários",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/usuarios",
              "host": ["{{baseUrl}}"],
              "path": ["usuarios"]
            }
          }
        },
        {
          "name": "4. Buscar usuário por ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/usuarios/{{testUserId}}",
              "host": ["{{baseUrl}}"],
              "path": ["usuarios", "{{testUserId}}"]
            }
          }
        },
        {
          "name": "5. Atualizar usuário",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "if (pm.environment.get(\"authToken\")) {",
                  " pm.request.headers.add({ key: \"Authorization\", value: pm.environment.get(\"authToken\") });",
                  "}"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 200 (or 201)\", () => {",
                  "  pm.expect([200,201]).to.include(pm.response.code);",
                  "});",
                  "",
                  "let json = {};",
                  "try { json = pm.response.json(); } catch(e) {}",
                  "",
                  "pm.test(\"Has message about update\", () => {",
                  "  pm.expect(json.message.toLowerCase()).to.match(/alterad|sucesso|edit/);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "{{authToken}}", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Usuário Teste Atualizado\",\n  \"email\": \"nicolas.test@mailinator.com\",\n  \"password\": \"teste123\",\n  \"administrador\": \"true\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/usuarios/{{testUserId}}",
              "host": ["{{baseUrl}}"],
              "path": ["usuarios", "{{testUserId}}"]
            }
          }
        },
        {
          "name": "6. Excluir usuário",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "{{authToken}}", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/usuarios/{{testUserId}}",
              "host": ["{{baseUrl}}"],
              "path": ["usuarios", "{{testUserId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Cenários negativos",
      "item": [
        {
          "name": "1. Criar usuário sem campo obrigatório",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Should return validation error\", () => {",
                  "  pm.expect([400,422]).to.include(pm.response.code);",
                  "});",
                  "",
                  "let json={};",
                  "try { json = pm.response.json(); } catch(e) {}",
                  "",
                  "pm.test(\"Has required field error\", () => {",
                  "  pm.expect(json.message.toLowerCase()).to.satisfy(m => m.includes(\"campo\") || m.includes(\"senha\") || m.includes(\"obrig\"));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "{{authToken}}", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Usuário Sem Senha\",\n  \"email\": \"teste_sem_senha@qa.com\",\n  \"administrador\": \"true\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/usuarios",
              "host": ["{{baseUrl}}"],
              "path": ["usuarios"]
            }
          }
        },
        {
          "name": "2. Criar usuário com e-mail duplicado",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Expect duplicate email error\", () => {",
                  "  pm.expect([400,409]).to.include(pm.response.code);",
                  "});",
                  "let json={};",
                  "try { json = pm.response.json(); } catch(e) {}",
                  "",
                  "pm.test(\"Duplicate email message\", () => {",
                  "  pm.expect(json.message.toLowerCase()).to.include(\"email\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "{{authToken}}", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Usuário Duplicado\",\n  \"email\": \"{{testUserEmail}}\",\n  \"password\": \"teste123\",\n  \"administrador\": \"false\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/usuarios",
              "host": ["{{baseUrl}}"],
              "path": ["usuarios"]
            }
          }
        },
        {
          "name": "3. Acessar endpoint sem token",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/usuarios",
              "host": ["{{baseUrl}}"],
              "path": ["usuarios"]
            }
          }
        },
        {
          "name": "4. Acessar endpoint com token inválido",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "token-invalido" }
            ],
            "url": {
              "raw": "{{baseUrl}}/usuarios",
              "host": ["{{baseUrl}}"],
              "path": ["usuarios"]
            }
          }
        },
        {
          "name": "5. Buscar usuário inexistente",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/usuarios/id_nao_existe_123",
              "host": ["{{baseUrl}}"],
              "path": ["usuarios", "id_nao_existe_123"]
            }
          }
        },
        {
          "name": "6. Atualizar usuário com e-mail duplicado",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Duplicate email update should fail\", () => {",
                  " pm.expect([400,409]).to.include(pm.response.code);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "{{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Usuário\",\n  \"email\": \"{{testUserEmail}}\",\n  \"password\": \"teste123\",\n  \"administrador\": \"true\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/usuarios/{{testUserId}}",
              "host": ["{{baseUrl}}"],
              "path": ["usuarios", "{{testUserId}}"]
            }
          }
        }
      ]
    }
  ]
}
