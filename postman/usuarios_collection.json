        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('List users status is 200', () => pm.expect(pm.response.code).to.equal(200));",
              "let json = {};",
              "try { json = pm.response.json(); } catch(e) { json = {}; }",
              "pm.test('Response contains usuarios array', () => {",
              "  pm.expect(json).to.have.property('usuarios');",
              "  pm.expect(json.usuarios).to.be.an('array');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "04 - Buscar usuário por ID",
