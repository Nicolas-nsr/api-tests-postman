{
  "info": {
    "_postman_id": "7b9d6f3a-collection-final",
    "name": "ServeRest - Usuarios (Final)",
    "description": "Coleção final completa para testes do recurso /usuarios na API ServeRest. Inclui setup (criar admin), login, CRUD e cenários negativos. Projetada para rodar via Postman Runner ou Newman (CI).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 - Setup (criar admin se necessário)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"{{adminName}}\",\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\",\n  \"administrador\": \"true\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/usuarios",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "usuarios"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Generate admin email/password if not set",
              "if (!pm.environment.get('adminEmail') || pm.environment.get('adminEmail') === '') {",
              "  const t = Date.now();",
              "  pm.environment.set('adminEmail', `admin_${t}@qa.local`);",
              "  pm.environment.set('adminPassword', `Pwd${t % 100000}`);",
              "  pm.environment.set('adminName', `Admin QA ${t}`);",
              "}",
              "// Keep duplicateEmail variable ready",
              "if (!pm.environment.get('duplicateEmail') || pm.environment.get('duplicateEmail') === '') {",
              "  pm.environment.set('duplicateEmail', `dup_${Date.now()}@qa.local`);",
              "}",
              "// Ensure testUserEmail variable exists placeholder",
              "if (!pm.environment.get('testUserEmail')) { pm.environment.set('testUserEmail', ''); }"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Try to parse response and handle already-created admin gracefully",
              "let json = {};",
              "try { json = pm.response.json(); } catch(e) { json = {}; }",
              "",
              "if (pm.response.code === 201) {",
              "  pm.test('Admin criado - status 201', () => pm.expect(pm.response.code).to.equal(201));",
              "  // Save admin id if present (not required later)",
              "  if (json._id) pm.environment.set('adminId', json._id);",
              "} else {",
              "  // If API returns 400 because admin exists, that's acceptable. We just proceed.",
              "  pm.test('Create admin returned non-201 (acceptable if already exists)', () => {",
              "    pm.expect([200,201,400,409]).to.include(pm.response.code);",
              "  });",
              "}",
              "",
              "// Ensure adminEmail / adminPassword are populated in environment (prerequest sets them if empty)",
              "pm.environment.set('adminEmail', pm.environment.get('adminEmail'));",
              "pm.environment.set('adminPassword', pm.environment.get('adminPassword'));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "01 - Login (obter token)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "login"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "let json = {};",
              "try { json = pm.response.json(); } catch(e) { json = {}; }",
              "",
              "pm.test('Login status is 200', () => {",
              "  pm.expect(pm.response.code).to.equal(200);",
              "});",
              "",
              "pm.test('Login returned authorization token (or token field)', () => {",
              "  pm.expect(json).to.satisfy(o => o && (o.authorization || o.token || o.auth));",
              "});",
              "",
              "(function saveToken(){",
              "  const raw = json.authorization || json.token || json.auth;",
              "  if (raw) {",
              "    const token = (raw.startsWith && raw.startsWith('Bearer ')) ? raw : `Bearer ${raw}`;",
              "    pm.environment.set('authToken', token);",
              "    console.log('Saved authToken');",
              "  }",
              "})();"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "02 - Criar usuário válido (caminho feliz)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "{{authToken}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Usuário Teste\",\n  \"email\": \"{{testUserEmail}}\",\n  \"password\": \"teste123\",\n  \"administrador\": \"false\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/usuarios",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "usuarios"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// ensure testUserEmail set uniquely",
              "if (!pm.environment.get('testUserEmail') || pm.environment.get('testUserEmail') === '') {",
              "  pm.environment.set('testUserEmail', `user_${Date.now()}@qa.local`);",
              "}",
              "// ensure duplicateEmail set",
              "if (!pm.environment.get('duplicateEmail') || pm.environment.get('duplicateEmail') === '') {",
              "  pm.environment.set('duplicateEmail', `dup_${Date.now()}@qa.local`);",
              "}"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "let json = {};",
              "try { json = pm.response.json(); } catch(e) { json = {}; }",
              "",
              "pm.test('Create user status is 201', () => {",
              "  pm.expect(pm.response.code).to.equal(201);",
              "});",
              "",
              "pm.test('Create user returned success message', () => {",
              "  pm.expect(json).to.have.property('message');",
              "  pm.expect(json.message.toLowerCase()).to.include('cadastro');",
              "});",
              "",
              "if (json._id) { pm.environment.set('testUserId', json._id); }",
              "else if (json.id) { pm.environment.set('testUserId', json.id); }"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "03 - Listar todos os usuários",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "{{authToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/usuarios",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "usuarios"
