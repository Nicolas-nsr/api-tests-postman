          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Get by id status 200', () => pm.expect(pm.response.code).to.equal(200));",
              "let json = {};",
              "try { json = pm.response.json(); } catch(e) { json = {}; }",
              "pm.test('Returned user has _id and matches testUserId', () => {",
              "  pm.expect(json).to.have.property('_id');",
              "  pm.expect(json._id).to.eql(pm.environment.get('testUserId'));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
